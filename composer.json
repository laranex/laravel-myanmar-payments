{
    "name": "laranex/laravel-myanmar-payments",
    "description": "A Laravel package for Myanmar payment gateways with a unified API",
    "keywords": [
        "laravel-myanmar-payments",
        "laranex",
        "laravel",
        "myanmar",
        "payments",
        "kbzpay",
        "wavemoney",
        "ayapay",
        "cybersource"
    ],
    "homepage": "https://github.com/laranex/laravel-myanmar-payments",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Nay Thu Khant",
            "email": "naythukhant644@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Laranex\\LaravelMyanmarPayments\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laranex\\LaravelMyanmarPayments\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laranex\\LaravelMyanmarPayments\\MyanmarPaymentsServiceProvider"
            ],
            "aliases": {
                "MyanmarPayments": "Laranex\\LaravelMyanmarPayments\\MyanmarPaymentsFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
